GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-4-hydrogen
# Optional, comma-separated. Tried in order when the primary returns 503/429 or times out.
GEMINI_FALLBACK_MODELS=
# Cost guardrails (optional)
GEMINI_DAILY_LIMIT=300
# LOW (default, used in the eval) or MINIMAL (not yet confirmed for gemini-4-hydrogen)
GEMINI_THINKING_LEVEL=LOW
